+
+/* ===== v36 — ενσωμάτωση στην εφαρμογή Προμηθειών ===== */
+body.embedded{background:#EEF2F8}
+body.embedded .topbar{display:none}
+body.embedded .app{max-width:none;min-height:100vh}
+body.embedded .tabs{top:0;background:#102f5c;padding-left:14px}
+body.embedded main{padding:16px clamp(12px,2.5vw,28px) 34px}
+.study-layout{display:grid;grid-template-columns:minmax(210px,300px) 1fr;gap:16px;align-items:start}
+.study-unit-list,.study-list{display:grid;gap:9px}
+.study-unit{width:100%;text-align:left;border:1px solid var(--line);background:#fff;border-radius:10px;padding:11px 13px;color:var(--ink);font-weight:700;cursor:pointer}
+.study-unit:hover{border-color:var(--aegean)}.study-unit.active{background:var(--aegean);border-color:var(--aegean);color:#fff}
+.study-unit small{display:block;font-weight:500;opacity:.78;margin-top:2px}
+.study-card{border:1px solid var(--line);background:#fff;border-radius:12px;padding:14px;box-shadow:var(--shadow)}
+.study-card h3{font-size:15px;margin:0 0 4px}.study-meta{font-size:12.5px;color:var(--ink-soft);margin-bottom:10px}
+.study-stats{display:grid;grid-template-columns:repeat(3,minmax(90px,1fr));gap:8px;margin:8px 0 12px}
+.study-stat{background:#f4f7fb;border:1px solid var(--line);border-radius:8px;padding:8px 9px}.study-stat b{display:block;font-size:14px}.study-stat span{font-size:10.5px;color:var(--ink-soft);text-transform:uppercase}
+.ctxbar{border-left:5px solid var(--aegean);background:#eef5fc;border-radius:10px;padding:11px 13px;margin-bottom:14px;font-size:13px}.ctxbar b{display:block;font-size:14px;margin-bottom:2px}
+@media(max-width:760px){.study-layout{grid-template-columns:1fr}.study-stats{grid-template-columns:1fr 1fr}}
+
